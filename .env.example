# Public — shipped in the client bundle. Nothing secret goes in this file.
# Copy to .env.local (gitignored) and fill in real values from your Supabase
# project settings once one exists; local dev can point at the local stack
# started with `npx supabase start` (it prints ANON_KEY / API_URL).

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key
VITE_APP_BASE_URL=http://localhost:5173
VITE_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key

# ---------------------------------------------------------------------------
# Secrets — NOT here, and not with a VITE_ prefix.
#
# Anything Vite sees as VITE_* is compiled into the browser bundle, where it
# is readable by anyone. These belong to Edge Functions and are set with
# `npx supabase secrets set NAME=value` (or the dashboard's Edge Function
# secrets), never in this file:
#
#   TURNSTILE_SECRET_KEY   verify-turnstile — the server half of the captcha
#   RESEND_API_KEY         send-email / send-invite — not yet built
#   RESEND_FROM            e.g. "CovertCook <dinner@yourdomain>"; the domain
#                          has to be verified with Resend first, or delivery
#                          silently goes to spam
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge
# Functions automatically — do not set them by hand.
